{
  "name": "deepfree",
  "version": "1.0.0",
  "description": "Minimal TypeScript authentication client for DeepSeek Web",
  "main": "dist/cli.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "prepare": "npm run build",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "deepseek",
    "authentication",
    "cli",
    "typescript"
  ],
  "author": "DeepFree Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.19.43",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "http-mitm-proxy": "^1.1.0",
    "playwright": "^1.40.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}
